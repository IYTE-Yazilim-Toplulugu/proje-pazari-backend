# .env.staging.example
# Staging environment — copy to .env.staging and fill in REAL values.
# Start with: docker-compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging up

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=staging

# ── Database ─────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/proje_pazari_staging
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=proje-pazari-files-staging

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_a_256bit_random_string

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME

# ── Alerting (optional) ───────────────────────────────────────────────────────
GF_ALERT_EMAIL_TO=team@iyte.edu.tr
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=CHANGE_ME
GF_SMTP_PASSWORD=CHANGE_ME
GF_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
