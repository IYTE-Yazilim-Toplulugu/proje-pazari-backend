# .env.prod.example
# Production environment — copy to .env.prod and fill in ALL values.
# NEVER commit .env.prod to version control.
# Start with: docker-compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=proje_pazari_db
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_strong_password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/proje_pazari_db

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_long_secret
MINIO_URL=http://minio:9000
MINIO_BUCKET=proje-pazari-files

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 characters, randomly generated (e.g.: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_minimum_64_character_random_string

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_strong_password
GF_SERVER_ROOT_URL=https://grafana.projepazari.site

# ── pgAdmin (disabled in prod — only used with --profile tools) ───────────────
PGADMIN_DEFAULT_EMAIL=admin@projepazari.site
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# ── Alerting ──────────────────────────────────────────────────────────────────
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=CHANGE_ME
GF_SMTP_PASSWORD=CHANGE_ME
GF_SMTP_FROM_ADDRESS=noreply@projepazari.site
GF_ALERT_EMAIL_TO=CHANGE_ME
GF_SLACK_WEBHOOK_URL=
GF_DISCORD_WEBHOOK_URL=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Browser-facing URL — must be the public API domain
NEXT_PUBLIC_API_BASE_URL=https://api.projepazari.site
