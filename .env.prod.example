# .env.prod.example
# Production environment — copy to .env.prod and fill in ALL values.
# NEVER commit .env.prod to version control.
# Start with: docker-compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database ─────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/proje_pazari_prod
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_strong_password

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_long_secret

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_minimum_32_character_random_string_for_HS256

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USERNAME=noreply@iyte.edu.tr
EMAIL_PASSWORD=CHANGE_ME

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_strong_password
GRAFANA_ROOT_URL=https://monitoring.projepazari.com

# ── Alerting ──────────────────────────────────────────────────────────────────
GF_ALERT_EMAIL_TO=devops@iyte.edu.tr
GF_SMTP_HOST=smtp.iyte.edu.tr:587
GF_SMTP_USER=CHANGE_ME
GF_SMTP_PASSWORD=CHANGE_ME
GF_SMTP_FROM_ADDRESS=monitoring@iyte.edu.tr
GF_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
GF_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME
