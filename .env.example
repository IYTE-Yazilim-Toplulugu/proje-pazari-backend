# .env.example — copy to .env and fill in all values before starting.
# NEVER commit .env to version control.
#
# Start: docker compose up -d --build
# With pgAdmin: docker compose --profile tools up -d

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=proje_pazari_db
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/proje_pazari_db

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_URL=http://minio:9000
MINIO_BUCKET=proje-pazari-files

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
GF_SERVER_ROOT_URL=https://grafana.projepazari.site

# ── Grafana Alerting (optional) ───────────────────────────────────────────────
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=noreply@projepazari.site
GF_ALERT_EMAIL_TO=
GF_SLACK_WEBHOOK_URL=
GF_DISCORD_WEBHOOK_URL=

# ── pgAdmin (only used with --profile tools) ──────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@projepazari.site
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# ── Frontend ──────────────────────────────────────────────────────────────────
# Browser-facing API URL — must be the public domain
NEXT_PUBLIC_API_BASE_URL=https://api.projepazari.site
