# .env.example — copy to .env and fill in all values before starting.
# NEVER commit .env to version control.
#
# Backend only:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build postgres redis minio elasticsearch minio-setup app
#
# Full local stack (frontend + Kibana + Logstash + monitoring + pgAdmin):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile monitoring --profile tools up -d --build

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=proje_pazari_db
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/proje_pazari_db

# ── Application image / profile ──────────────────────────────────────────────
APP_IMAGE=proje-pazari-backend:local-prod
SPRING_PROFILES_ACTIVE=prod

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ADMIN_USER=CHANGE_ME
MINIO_ADMIN_PASSWORD=CHANGE_ME
MINIO_APP_ACCESS_KEY=CHANGE_ME
MINIO_APP_SECRET_KEY=CHANGE_ME
MINIO_URL=http://minio:9000
MINIO_BUCKET=proje-pazari-files
MINIO_FILES_BUCKET=proje-pazari-files
MINIO_AVATARS_BUCKET=proje-pazari-avatars
MINIO_DOCUMENTS_BUCKET=proje-pazari-documents
MINIO_BACKUPS_BUCKET=proje-pazari-backups

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# ── Elasticsearch / Kibana / Logstash ────────────────────────────────────────
# Generate each password with: openssl rand -base64 32
ELASTIC_PASSWORD=CHANGE_ME
KIBANA_SYSTEM_PASSWORD=CHANGE_ME

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
GF_SERVER_ROOT_URL=http://localhost:3030

# ── Grafana Alerting (optional) ───────────────────────────────────────────────
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=noreply@projepazari.site
# Local full-stack startup requires syntactically valid contact points.
GF_ALERT_EMAIL_TO=local-alerts@example.com
GF_SLACK_WEBHOOK_URL=http://localhost:1/slack-webhook-placeholder
GF_DISCORD_WEBHOOK_URL=http://localhost:1/discord-webhook-placeholder

# ── pgAdmin (only used with --profile tools) ──────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@projepazari.site
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# ── Frontend ──────────────────────────────────────────────────────────────────
# Browser-facing API URL. Use http://localhost:8080 for local full-stack.
FRONTEND_URL=http://localhost:3000
FRONTEND_VERIFY_EMAIL_PATH=/verify-email
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
