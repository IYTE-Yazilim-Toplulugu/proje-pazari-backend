# .env.dev.example
# Development environment — copy to .env and fill in values.
# Start with: docker-compose up

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=proje_pazari_db
POSTGRES_USER=yazilim
POSTGRES_PASSWORD=yazilim123
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/proje_pazari_db

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_URL=http://minio:9000
MINIO_BUCKET=proje-pazari-files

# ── JWT (dev only — DO NOT reuse in staging/prod) ─────────────────────────────
JWT_SECRET=proje-pazari-dev-secret-key-2025-change-in-production

# ── Email (dev — use a local mailhog or leave empty) ─────────────────────────
EMAIL_USERNAME=dev@example.com
EMAIL_PASSWORD=dev-password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_SERVER_ROOT_URL=http://localhost:3030

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@projepazari.site
PGADMIN_DEFAULT_PASSWORD=admin

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
