# .env.dev.example
# Development environment — copy to .env.dev and fill in values.
# Start with: docker-compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up

# ── Spring ──────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Database ─────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/proje_pazari_db
SPRING_DATASOURCE_USERNAME=yazilim
SPRING_DATASOURCE_PASSWORD=yazilim123

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=proje-pazari-files

# ── JWT (dev only — DO NOT reuse in staging/prod) ─────────────────────────────
JWT_SECRET=proje-pazari-dev-secret-key-2025-change-in-production

# ── Email (dev — use a local mailhog or leave empty) ─────────────────────────
EMAIL_USERNAME=dev@example.com
EMAIL_PASSWORD=dev-password

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin123
