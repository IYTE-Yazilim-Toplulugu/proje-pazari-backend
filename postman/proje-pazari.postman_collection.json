{
	"info": {
		"_postman_id": "proje-pazari-api-collection",
		"name": "Proje Pazari API",
		"description": "Complete API collection for Proje Pazari Backend.\n\nBase URL: {{base_url}}\n\nAuthentication: JWT Bearer Token via {{access_token}} variable.\n\nWorkflow:\n1. Register a user\n2. Verify email\n3. Login to get access_token\n4. Use authenticated endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.test(\"Response time is less than 500ms\", function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(500);",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "project_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "application_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"description": "Authentication endpoints (public)",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has user data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('email');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@std.iyte.edu.tr\",\n    \"password\": \"SecurePass123!\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Register a new user. Email must be an IYTE domain (@std.iyte.edu.tr or @iyte.edu.tr)."
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has access token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.accessToken).to.be.a('string');",
									"    pm.collectionVariables.set(\"access_token\", jsonData.data.accessToken);",
									"});",
									"",
									"pm.test(\"Response has refresh token\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.refreshToken) {",
									"        pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    }",
									"});",
									"",
									"pm.test(\"Response has user ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data.userId) {",
									"        pm.collectionVariables.set(\"user_id\", jsonData.data.userId);",
									"    }",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@std.iyte.edu.tr\",\n    \"password\": \"SecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login with credentials. Automatically saves access_token, refresh_token, and user_id to collection variables."
					}
				},
				{
					"name": "Verify Email",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/v1/auth/verify-email?token=your-verification-token",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "verify-email"],
							"query": [
								{
									"key": "token",
									"value": "your-verification-token",
									"description": "Verification token received via email"
								}
							]
						},
						"description": "Verify user email with the token sent to their email address."
					}
				},
				{
					"name": "Resend Verification Email",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@std.iyte.edu.tr\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/resend-verification",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "resend-verification"]
						},
						"description": "Resend email verification for unverified accounts."
					}
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"New access token received\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.accessToken).to.be.a('string');",
									"    pm.collectionVariables.set(\"access_token\", jsonData.data.accessToken);",
									"    if (jsonData.data.refreshToken) {",
									"        pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
									"    }",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"url": {
							"raw": "{{base_url}}/api/v1/auth/refresh?refreshToken={{refresh_token}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "refresh"],
							"query": [
								{
									"key": "refreshToken",
									"value": "{{refresh_token}}"
								}
							]
						},
						"description": "Refresh the access token using a valid refresh token. Automatically updates access_token variable."
					}
				}
			]
		},
